# streaming-agent configuration — copy to .env and edit.
# Only AGENT_TOKEN is required. See INSTALL.md for the full walkthrough.

# --- Auth (required) ---
# Shared bearer token the portal must present. Generate: openssl rand -hex 32
# The agent refuses to start without it (min 32 chars).
AGENT_TOKEN=

# --- Networking ---
# Bind address. Default is loopback. Use 0.0.0.0 ONLY with AGENT_ALLOWED_IPS set
# (the agent refuses 0.0.0.0 without an allowlist). Traffic should reach it over
# Tailscale, not the public internet.
AGENT_HOST=0.0.0.0
AGENT_PORT=8787

# Comma-separated IP allowlist = the portal's tailnet IP(s), e.g. 100.x.y.z
AGENT_ALLOWED_IPS=

# Label shown in the portal (defaults to the hostname).
AGENT_SERVER_NAME=

# --- Job execution ---
# Concurrency. Keep 1 — deploys touch nginx/php-fpm and race if parallel.
AGENT_MAX_CONCURRENT=1
# Hard timeout per job (ms). Default 20m.
AGENT_JOB_TIMEOUT_MS=1200000
# Longer timeout just for DB migrations (ms). Default 2h. Raise for huge DBs.
AGENT_MIGRATE_TIMEOUT_MS=7200000

# --- Deploy secrets (required) ---
# Written into every deployed site's .env. These were once hardcoded in the
# source and have been rotated; the agent refuses to start if any is missing.
ADVMO_DOS_KEY=
ADVMO_DOS_SECRET=
TELEGRAM_BOT_TOKEN=
SEO_MONITOR_TOKEN=
CDN_API_KEY=

# --- Repo allowlist ---
# `git clone` runs as root and will execute ext:: transports, so only the
# known app repo is ever cloned. Add more (comma-separated) to permit others.
AGENT_REPO_ALLOWLIST=

# --- Misc ---
# Trust X-Forwarded-For (only behind a known proxy).
AGENT_TRUST_PROXY=0
# Where DB-migrate dumps are written.
DUMP_DIR=/var/backups/db-migrations
